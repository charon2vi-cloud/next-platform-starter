# --- VIP Parking review system -------------------------------------------

# REQUIRED. Signs the QR tokens. Without it the app falls back to a public
# development secret and anyone could mint a QR that credits any driver.
# Generate one with:  openssl rand -base64 48
VIP_QR_SECRET=

# REQUIRED before sharing the dashboard link. Without it /dashboard is open.
VIP_DASHBOARD_PASSWORD=
# Optional: separate signing key for dashboard sessions (defaults to VIP_QR_SECRET).
VIP_DASHBOARD_SECRET=

# The Google Place ID of the business listing. This is what makes the
# "write a review" composer open directly instead of the plain Maps listing.
# Find it with the Place ID Finder:
# https://developers.google.com/maps/documentation/places/web-service/place-id
NEXT_PUBLIC_VIP_GOOGLE_PLACE_ID=

# Alternative to the Place ID: the short review link from your Google Business
# Profile ("Ask for reviews" / "Get more reviews"), e.g. https://g.page/r/XXXX/review
NEXT_PUBLIC_VIP_GOOGLE_REVIEW_URL=

# Public origin the QR codes point at. Defaults to the request host in the QR
# studio, so you only need this if codes are generated on a different domain.
NEXT_PUBLIC_VIP_ORIGIN=https://vipparkingalicante.com

# --- Branding (all optional) ---------------------------------------------
NEXT_PUBLIC_VIP_BRAND_NAME=VIP Parking Alicante
NEXT_PUBLIC_VIP_WEBSITE=https://vipparkingalicante.com
NEXT_PUBLIC_VIP_LOGO=/vip/logo.svg
NEXT_PUBLIC_VIP_SUPPORT_EMAIL=info@vipparkingalicante.com
NEXT_PUBLIC_VIP_GOOGLE_MAPS_URL=https://maps.app.goo.gl/REdk8DZG58KokFhd9
